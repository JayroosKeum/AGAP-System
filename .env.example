# Application URL (HTTPS in production)
AGAP_APP_URL=https://agap.example.gov.ph

# Database credentials. Set these in your server's secret manager or runtime
# environment; do not commit a populated .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agap_db
DB_USER=agap_app
DB_PASS=change-me

# Google Gemini API. Configure this as a server environment variable or secret.
# Do not store a production key in source control or browser JavaScript.
GEMINI_API_KEY=
