Options -Indexes

RewriteEngine On
RewriteRule ^activate$ activate.php [L,QSA]
RewriteRule ^verify-email$ verify-email.php [L,QSA]

# Block direct web access to internal backend code and database scripts.
RewriteRule ^backend/(?!api/) - [F,L]
RewriteRule ^database/ - [F,L]

<FilesMatch "(^\.|composer\.(json|lock)$|\.(sql|log|ini|bak|env|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=()"
    Header always set X-XSS-Protection "0"
</IfModule>
