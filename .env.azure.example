# Copy these values into Azure App Service > Configuration > Application settings.
# Do not commit a file containing real credentials.
DB_HOST=your-server.mysql.database.azure.com
DB_PORT=3306
DB_NAME=agap_db
DB_USER=your_database_user
DB_PASS=replace-with-a-secret

# Required when password-reset emails should link to the deployed application.
AGAP_APP_URL=https://your-app-name.azurewebsites.net

# Optional: only needed for AGAP AI features.
GEMINI_API_KEY=

# Optional: absolute path to a CA certificate if the MySQL server requires a
# certificate authority file for TLS verification.
DB_SSL_CA=
