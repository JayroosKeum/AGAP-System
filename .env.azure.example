# Copy these values into Azure App Service > Settings > Environment variables (Application settings).
# Do not commit a file containing real credentials.

# Azure Database for MySQL Flexible Server
DB_HOST=your-server.mysql.database.azure.com
DB_PORT=3306
DB_NAME=agap_db
DB_USER=your_database_user
DB_PASS=replace-with-a-secret

# Optional: custom CA path. Leave unset on Azure Linux to use /etc/ssl/certs/ca-certificates.crt automatically.
DB_SSL_CA=

# Required so verification and password-reset emails link to the deployed site.
AGAP_APP_URL=https://your-app-name.azurewebsites.net

# Gmail SMTP (use a 16-character Google App Password, never your normal Gmail password).
GMAIL_SMTP_USERNAME=your-sender@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-a-google-app-password

# Optional: enables AI features (Narrative Refinement, OCR Scans, Audio Transcription, Case Summary).
GEMINI_API_KEY=

# Optional: Google Identity Services Web client ID for Resident Portal Google sign-in & registration.
# Add your Azure HTTPS origin (e.g. https://your-app-name.azurewebsites.net) to Authorized JavaScript origins in Google Cloud Console.
GOOGLE_RESIDENT_CLIENT_ID=

# Optional: 32-byte/base64 secret for AES-256-GCM PII encryption (e.g. base64:<44-char-base64-key>).
# Once set and used in production, back up this key safely — losing it makes encrypted PII unreadable.
APP_PII_KEY=
